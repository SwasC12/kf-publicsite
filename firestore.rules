rules_version = '2';

// Firestore security rules for the shared Kauā Fragrances project (perfume-3b075).
// Used by BOTH the Oil Tracker admin app and the kf-publicsite storefront.
// Keep this file identical in both repos.
//
// SETUP: replace the UID in isAdmin() if the admin user changes, then paste this
// whole file into console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal Oil Tracker sync — no login; knowing the 6+ char code grants access.
    // Writes may only carry the sync fields, so the collection can't be used as
    // free general-purpose storage. Pick a long, random code (12+ chars).
    match /workspaces/{code} {
      function validCode() { return code.size() >= 6 && code.size() <= 128; }
      allow get, delete: if validCode();
      allow create, update: if validCode()
        && request.resource.data.keys().hasOnly(['oils', 'rumi', 'wishlist', 'updatedAt']);
      allow list: if false;
    }

    // Shop catalogue — shoppers only see active products; admin manages all.
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Product reviews — anyone may post one, but it arrives unapproved and stays
    // hidden until the admin approves it. The public shop queries approved == true.
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 128
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is number)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 600
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['productId', 'name', 'rating', 'text', 'approved', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Editable storefront content (banners, hero, announcement) — public read, admin write.
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings (delivery, whatsapp, contact…) — public read, admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order-status mirror, written by the shop Worker (Admin SDK) and the admin app.
    // Not public: references are short and guessable, and the shop's Track page
    // looks orders up through the Worker's /api/lookup-order (reference + email).
    match /orderStatus/{ref} {
      allow read, write: if isAdmin();
    }

    // Customer profiles — each customer manages their own; the admin can view/modify all.
    match /customers/{uid} {
      // A customer may only store their own profile fields (no extra keys such as
      // roles or credit balances that admin tooling might later trust).
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'billing', 'delivery', 'updatedAt'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid));
    }

    // Referral codes / progress — managed by the shop Worker (Admin SDK).
    // The admin app reads them; nobody else gets browser access.
    match /referrals/{id} {
      allow read, write: if isAdmin();
    }

    // Promo codes are checked by the shop Worker (Admin SDK). No browser reads.
    match /discounts/{code} {
      allow read, write: if isAdmin();
    }

    // "Notify me when back in stock" requests — anyone can create; only admin reads/manages.
    match /restockRequests/{id} {
      allow create: if request.resource.data.notified == false
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 128
        && (!('productName' in request.resource.data) || (request.resource.data.productName is string && request.resource.data.productName.size() <= 200))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is number)
        && request.resource.data.keys().hasOnly(['productId', 'productName', 'email', 'createdAt', 'notified']);
      allow read, update, delete: if isAdmin();
    }

    // Orders — written by the shop Worker (Admin SDK) or the admin POS screen.
    // A signed-in customer may read only their own order history.
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Customer display: the till mirrors its cart to posDisplay/current and a
    // second device signed in as the admin shows it to the customer.
    match /posDisplay/{id} {
      allow read, write: if isAdmin();
    }

    // Business expenses (Budgeting tab) — admin only, never public.
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'iQjj1HHAUAM6BzWGcoYWepQCpRx2';
    }
  }
}
